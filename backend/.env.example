# SQLite works with no extra install. For Postgres:
# DATABASE_URL=postgresql+psycopg://pathwise:pathwise@localhost:5432/pathwise
DATABASE_URL=sqlite:///./pathwise.db
JWT_SECRET=dev-only-pathwise-local-signing-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10080

# Client IDs for the PathWise app (com.pathwise.app), comma-separated.
# Publish the Google audience so any Google account can sign in.
GOOGLE_CLIENT_IDS=
