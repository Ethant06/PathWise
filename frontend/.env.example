# Where the phone reaches FastAPI. Git shares this template, not your personal URL.
# Restart Expo after you change .env.
# mock-api runs on port 8000. The real backend (backend/) runs on port 8020.

# Android emulator on Windows
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# iPhone or a real Android phone, same network as the laptop (ipconfig → IPv4 Address):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000

# iOS Simulator on a Mac:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in while the app runs in Expo Go.
# iOS client bundle ID: host.exp.Exponent. Android package: host.exp.exponent.
# Publish the Google audience so every Google account can sign in, then paste the client IDs here.
# Restart Expo after changing this file.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
