# Copy this file to .env. Git ignores .env. Restart Expo after you edit it.
# The live API is backend/ on port 8020. mock-api/ stays on port 8000.

# Same machine (iOS Simulator, or a browser-less check from the laptop):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8020

# A real phone on the same network. ipconfig → IPv4 Address. Replace the host.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8020

# Android emulator on Windows talks to the host through this address:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8020

# Google sign-in in Expo Go. iOS bundle ID: host.exp.Exponent.
# Android package: host.exp.exponent. Leave blank to use email sign-up only.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
